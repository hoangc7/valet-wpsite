# wpsite config — plain bash, sourced on every run.

SITES_DIR="$HOME/Sites"        # where site folders are created (parked or not — see VALET_LINK)
TLD=""                         # leave empty to auto-detect from `valet tld`

DB_USER="root"
DB_PASS=""
DB_HOST="127.0.0.1"
DB_PREFIX="wp_"
# folder containing the mysql client, only if it isn't on PATH (usually auto-detected)
# e.g. MYSQL_BIN_DIR="/opt/homebrew/opt/mysql@8.4/bin"
MYSQL_BIN_DIR=""

ADMIN_USER="admin"
ADMIN_PASS="password"
ADMIN_EMAIL="admin@example.test"

SECURE=0                       # 1 = https by default
VALET_LINK="auto"              # auto = `valet link` each site unless SITES_DIR is parked; 1 = always; 0 = never
OPEN_BROWSER=1
REMOVE_DEFAULTS=1
WP_DEBUG=1

# wp.org plugin slugs installed on every site
DEFAULT_PLUGINS="query-monitor"

# extra plugins only for `--woo` sites
WOO_PLUGINS=""

# multisite: subsites created by --multisite (a number, or names like "shop,blog")
MULTISITE_SITES=2
# install the Valet driver that subdirectory multisite needs (into ~/.config/valet/Drivers)
MULTISITE_DRIVER_AUTOINSTALL=1

# demo data imported into every new site: "", "unittest", "woo" or "all"
DEFAULT_DEMO=""
DEMO_IMAGES=1                  # 0 = skip demo images (faster, works offline)

# your local plugin/theme source folders, symlinked (not copied) into every site
# e.g. LINK_PLUGINS="$HOME/Code/my-plugin $HOME/Code/another-plugin"
LINK_PLUGINS=""
LINK_THEMES=""
