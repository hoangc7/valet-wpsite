#!/usr/bin/env bash
#
# wpsite — create / delete local WordPress sites with Laravel Valet + WP-CLI.
# Inspired by ValetPress by Shelby DeNike (github.com/sdenike/valetpress),
# based on the original by Aaron Rutley (github.com/AaronRutley/valetpress).
# https://github.com/hoangc7/valet-wpsite
#
# Usage:
#   wpsite create <name> [--woo] [--theme=<slug|zip|path>] [--plugins="a b c"]
#                        [--php=8.3] [--secure] [--no-open] [--wp=<version>]
#                        [--demo=unittest|woo|all] [--no-images]
#   wpsite demo <name> <unittest|woo|all> [--no-images]
#   wpsite delete <name> [-y]
#   wpsite list
#   wpsite open <name>
#   wpsite config        # create/edit the config file
#   wpsite help

set -euo pipefail

VERSION="1.0.0"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/wpsite"
CONFIG_FILE="$CONFIG_DIR/config"
MARKER=".wpsite"   # every site this script creates gets this file; delete refuses folders without it

# ---------------------------------------------------------------- defaults ---
SITES_DIR="$HOME/Sites"          # a folder you've run `valet park` in
TLD=""                           # auto-detected from `valet tld` if empty
DB_USER="root"
DB_PASS=""
DB_HOST="127.0.0.1"
DB_PREFIX="wp_"                  # database name = ${DB_PREFIX}<site>
ADMIN_USER="admin"
ADMIN_PASS="password"
ADMIN_EMAIL="admin@example.test"
SECURE=0                         # 1 = run `valet secure` (https) by default
OPEN_BROWSER=1
REMOVE_DEFAULTS=1                # remove Hello Dolly, Akismet and extra default themes
DEFAULT_PLUGINS=""               # space-separated wp.org slugs installed on every site
WOO_PLUGINS=""                   # extra plugins added only with --woo
LINK_PLUGINS=""                  # space-separated local plugin dirs to SYMLINK into every site
LINK_THEMES=""                   # space-separated local theme dirs to SYMLINK into every site
WP_DEBUG=1
DEFAULT_DEMO=""                  # demo data for every new site: unittest, woo, all (or empty)
DEMO_IMAGES=1                    # 0 = skip image attachments (much faster import)
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/wpsite"
UNITTEST_XML_URL="https://raw.githubusercontent.com/WPTT/theme-unit-test/master/themeunittestdata.wordpress.xml"
WOO_XML_URL="https://raw.githubusercontent.com/woocommerce/woocommerce/trunk/plugins/woocommerce/sample-data/sample_products.xml"

# shellcheck source=/dev/null
[[ -f "$CONFIG_FILE" ]] && source "$CONFIG_FILE"

# ------------------------------------------------------------------ output ---
if [[ -t 1 ]]; then
  c_red=$'\e[31m'; c_grn=$'\e[32m'; c_ylw=$'\e[33m'; c_cyn=$'\e[36m'; c_dim=$'\e[2m'; c_b=$'\e[1m'; c_0=$'\e[0m'
else
  c_red=""; c_grn=""; c_ylw=""; c_cyn=""; c_dim=""; c_b=""; c_0=""
fi
info() { echo "${c_cyn}→${c_0} $*"; }
ok()   { echo "${c_grn}✓${c_0} $*"; }
warn() { echo "${c_ylw}!${c_0} $*" >&2; }
die()  { echo "${c_red}✗ $*${c_0}" >&2; exit 1; }

# ----------------------------------------------------------------- helpers ---
has() { command -v "$1" >/dev/null 2>&1; }

require() {
  has wp    || die "WP-CLI not found. Install: https://wp-cli.org/#installing"
  has mysql || warn "mysql client not found — WP-CLI's db commands may still work, continuing."
}

detect_tld() {
  if [[ -z "$TLD" ]]; then
    if has valet; then TLD="$(valet tld 2>/dev/null | tail -n1 | tr -d '[:space:]')"; fi
    TLD="${TLD:-test}"
  fi
}

# site name: lowercase letters, digits, hyphens
validate_name() {
  local n="${1:-}"
  [[ -n "$n" ]] || die "Site name required."
  [[ "$n" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || die "Invalid name '$n' (use lowercase letters, digits, hyphens)."
}

db_name_for() { echo "${DB_PREFIX}${1//-/_}"; }

site_url() {
  local scheme="http"
  [[ "${2:-0}" == 1 ]] && scheme="https"
  echo "$scheme://$1.$TLD"
}

is_secured() { has valet && valet secured 2>/dev/null | grep -qE "(^|[^a-z0-9-])$1\.$TLD([^a-z0-9.-]|$)"; }

open_url() {
  [[ "$OPEN_BROWSER" == 1 ]] || return 0
  if has open; then open "$1"; elif has xdg-open; then xdg-open "$1" >/dev/null 2>&1 & fi
}

confirm() {
  local reply
  read -r -p "$1 [y/N] " reply
  [[ "$reply" =~ ^[Yy]$ ]]
}

wpc() { wp --path="$SITE_DIR" --quiet "$@"; }

# -------------------------------------------------------------- demo data ---
# normalise "unittest,woo" / "all" -> "unittest woo"
parse_demo() {
  local out="" t
  for t in ${1//,/ }; do
    case "$t" in
      all)                         out="$out unittest woo" ;;
      unittest|unit-test|unit|tut) out="$out unittest" ;;
      woo|woocommerce|products)    out="$out woo" ;;
      *) die "Unknown demo type '$t' (use: unittest, woo, all)" ;;
    esac
  done
  # de-duplicate, keep order
  echo "$out" | tr ' ' '\n' | awk 'NF && !seen[$0]++' | xargs
}

# download once, reuse from cache afterwards
fetch_cached() {
  local url="$1" file="$CACHE_DIR/$2"
  mkdir -p "$CACHE_DIR"
  if [[ ! -s "$file" ]]; then
    info "Downloading $2…" >&2
    curl -fsSL "$url" -o "$file.tmp" || { rm -f "$file.tmp"; die "Download failed: $url"; }
    mv "$file.tmp" "$file"
  fi
  echo "$file"
}

ensure_importer() {
  if ! wp --path="$SITE_DIR" plugin is-installed wordpress-importer 2>/dev/null; then
    info "Installing WordPress Importer…"
    wpc plugin install wordpress-importer || { warn "Couldn't install the WordPress Importer plugin."; return 1; }
  fi
  wpc plugin activate wordpress-importer 2>/dev/null || wp --path="$SITE_DIR" plugin is-active wordpress-importer
}

# wp import, optionally skipping image attachments
run_import() {
  local file="$1" images="$2" skip=()
  [[ "$images" == 1 ]] || skip=(--skip=attachment)
  wp --path="$SITE_DIR" import "$file" --authors=create "${skip[@]}" >/tmp/wpsite-import.log 2>&1 \
    || { tail -n 20 /tmp/wpsite-import.log >&2; return 1; }
  local failed
  failed="$(grep 'Failed to import' /tmp/wpsite-import.log | grep -vc 'Fetching attachments is not enabled' || true)"
  [[ "$failed" == 0 ]] || warn "$failed items failed to import (usually remote images) — see /tmp/wpsite-import.log"
}

import_unittest() {
  local images="$1" xml
  xml="$(fetch_cached "$UNITTEST_XML_URL" themeunittestdata.wordpress.xml)" || return 1
  ensure_importer || return 1
  info "Importing Theme Unit Test data$([[ $images == 1 ]] || echo ' (no images)')…"
  run_import "$xml" "$images" || return 1
  # put the first imported menu into the theme's first menu location (classic themes)
  local menu loc
  menu="$(wp --path="$SITE_DIR" menu list --format=ids 2>/dev/null | awk '{print $1}')"
  loc="$(wp --path="$SITE_DIR" menu location list --format=ids 2>/dev/null | awk '{print $1}')"
  if [[ -n "$menu" && -n "$loc" ]]; then wpc menu location assign "$menu" "$loc" 2>/dev/null || true; fi
  ok "Theme Unit Test data imported ($(wp --path="$SITE_DIR" post list --post_type=post --format=count) posts, $(wp --path="$SITE_DIR" post list --post_type=page --format=count) pages)"
}

ensure_woocommerce() {
  if ! wp --path="$SITE_DIR" plugin is-active woocommerce 2>/dev/null; then
    if wp --path="$SITE_DIR" plugin is-installed woocommerce 2>/dev/null; then
      info "Activating WooCommerce…"
      wpc plugin activate woocommerce || return 1
    else
      info "Installing WooCommerce…"
      wpc plugin install woocommerce --activate || { warn "Couldn't install WooCommerce."; return 1; }
    fi
    # skip the onboarding wizard / coming-soon mode
    wpc option update woocommerce_onboarding_profile '{"skipped":true}' --format=json 2>/dev/null || true
    wpc option update woocommerce_task_list_hidden yes 2>/dev/null || true
    wpc option update woocommerce_coming_soon no 2>/dev/null || true
  fi
}

import_woo() {
  local images="$1" xml
  ensure_woocommerce || return 1
  # WooCommerce ships the sample file — use it, fall back to GitHub
  xml="$SITE_DIR/wp-content/plugins/woocommerce/sample-data/sample_products.xml"
  if [[ ! -f "$xml" ]]; then xml="$(fetch_cached "$WOO_XML_URL" woocommerce_sample_products.xml)" || return 1; fi
  ensure_importer || return 1

  # The sample file uses global attributes (pa_color, pa_size). WooCommerce only
  # registers them during an *admin* import, so create them first — otherwise
  # variable products lose their attributes when imported from the CLI.
  wpc eval '
    foreach ( array( "color" => "Color", "size" => "Size" ) as $slug => $name ) {
      if ( ! wc_attribute_taxonomy_id_by_name( $slug ) ) {
        wc_create_attribute( array( "name" => $name, "slug" => $slug, "type" => "select", "order_by" => "menu_order" ) );
      }
    }
    delete_transient( "wc_attribute_taxonomies" );' || return 1

  info "Importing WooCommerce sample products$([[ $images == 1 ]] || echo ' (no images)')…"
  run_import "$xml" "$images" || return 1

  wpc eval 'if ( function_exists( "wc_update_product_lookup_tables" ) ) { wc_update_product_lookup_tables(); } wc_delete_product_transients();' || true
  wpc transient delete --all || true
  ok "WooCommerce sample data imported ($(wp --path="$SITE_DIR" post list --post_type=product --format=count) products)"
}

import_demo() {
  local types="$1" images="$2" t
  for t in $types; do
    case "$t" in
      unittest) import_unittest "$images" || return 1 ;;
      woo)      import_woo "$images" || return 1 ;;
    esac
  done
}

cmd_demo() {
  local name="" types="" images="$DEMO_IMAGES" arg
  for arg in "$@"; do
    case "$arg" in
      --no-images) images=0 ;;
      --images)    images=1 ;;
      -*)          die "Unknown option: $arg" ;;
      *)           if [[ -z "$name" ]]; then name="$arg"; else types="$types $arg"; fi ;;
    esac
  done
  validate_name "$name"
  types="$(parse_demo "$types")"
  [[ -n "$types" ]] || die "Which demo data? wpsite demo $name <unittest|woo|all>"
  require
  SITE_DIR="$SITES_DIR/$name"
  [[ -f "$SITE_DIR/wp-config.php" ]] || die "No WordPress site at $SITE_DIR"
  import_demo "$types" "$images" || die "Demo import failed."
}

# ------------------------------------------------------------------ create ---
cmd_create() {
  local name="" woo=0 theme="" plugins="" php="" secure="$SECURE" wpver="" demo="$DEFAULT_DEMO" images="$DEMO_IMAGES"
  for arg in "$@"; do
    case "$arg" in
      --woo)          woo=1 ;;
      --theme=*)      theme="${arg#*=}" ;;
      --plugins=*)    plugins="${arg#*=}" ;;
      --php=*)        php="${arg#*=}" ;;
      --wp=*)         wpver="${arg#*=}" ;;
      --secure)       secure=1 ;;
      --no-secure)    secure=0 ;;
      --no-open)      OPEN_BROWSER=0 ;;
      --demo)         demo="all" ;;
      --demo=*)       demo="${arg#*=}" ;;
      --no-demo)      demo="" ;;
      --no-images)    images=0 ;;
      -*)             die "Unknown option: $arg" ;;
      *)              name="$arg" ;;
    esac
  done

  if [[ -z "$name" ]]; then read -r -p "Site name: " name; fi
  validate_name "$name"
  demo="$(parse_demo "$demo")"
  if [[ " $demo " == *" woo "* ]]; then woo=1; fi
  require; detect_tld

  SITE_DIR="$SITES_DIR/$name"
  local db; db="$(db_name_for "$name")"
  local url; url="$(site_url "$name" "$secure")"

  [[ -d "$SITES_DIR" ]] || die "Sites folder not found: $SITES_DIR (set SITES_DIR in $CONFIG_FILE)"
  if [[ -e "$SITE_DIR" ]]; then
    die "$SITE_DIR already exists. Run 'wpsite delete $name' first."
  fi

  local start=$SECONDS
  echo "${c_b}Creating $name${c_0} ${c_dim}($url, db: $db)${c_0}"

  mkdir -p "$SITE_DIR"
  echo "created=$(date +%Y-%m-%dT%H:%M:%S) db=$db" > "$SITE_DIR/$MARKER"
  # if anything fails from here on, clean up the half-built site
  # (only drops the DB if this run created it)
  CREATE_DONE=0; DB_CREATED=0
  trap '[[ $CREATE_DONE == 1 ]] || { warn "Create failed — cleaning up."; [[ $DB_CREATED == 1 ]] && wp --path="$SITE_DIR" db drop --yes --quiet 2>/dev/null; rm -rf -- "$SITE_DIR"; }' EXIT

  info "Downloading WordPress${wpver:+ $wpver}…"
  wpc core download ${wpver:+--version="$wpver"}

  info "Writing wp-config.php…"
  wpc config create --dbname="$db" --dbuser="$DB_USER" --dbpass="$DB_PASS" --dbhost="$DB_HOST" --skip-check
  wpc config set WP_ENVIRONMENT_TYPE local
  wpc config set FS_METHOD direct
  wpc config set WP_DEBUG "$([[ $WP_DEBUG == 1 ]] && echo true || echo false)" --raw
  wpc config set WP_DEBUG_LOG true --raw
  wpc config set WP_DEBUG_DISPLAY false --raw
  wpc config set SCRIPT_DEBUG "$([[ $WP_DEBUG == 1 ]] && echo true || echo false)" --raw

  info "Creating database…"
  if wpc db check >/dev/null 2>&1; then
    die "Database '$db' already exists. Drop it first or change DB_PREFIX."
  fi
  wpc db create
  DB_CREATED=1

  info "Installing WordPress…"
  wpc core install --url="$url" --title="$name" \
    --admin_user="$ADMIN_USER" --admin_password="$ADMIN_PASS" --admin_email="$ADMIN_EMAIL" --skip-email
  wpc rewrite structure '/%postname%/'
  wpc option update blog_public 0

  if [[ "$woo" == 1 ]]; then
    ensure_woocommerce
    if [[ -n "$WOO_PLUGINS" ]]; then
      info "Installing: $WOO_PLUGINS"
      # shellcheck disable=SC2086
      wpc plugin install $WOO_PLUGINS --activate
    fi
  fi

  local all_plugins="$DEFAULT_PLUGINS $plugins"
  all_plugins="$(echo "$all_plugins" | xargs)"
  if [[ -n "$all_plugins" ]]; then
    info "Installing plugins: $all_plugins"
    # word-splitting is intentional here
    # shellcheck disable=SC2086
    wpc plugin install $all_plugins --activate
  fi

  local p
  for p in $LINK_PLUGINS; do
    p="${p/#\~/$HOME}"
    if [[ -d "$p" ]]; then
      ln -s "$p" "$SITE_DIR/wp-content/plugins/$(basename "$p")"
      wpc plugin activate "$(basename "$p")" || warn "Could not activate $(basename "$p")"
      ok "Linked plugin $(basename "$p")"
    else
      warn "LINK_PLUGINS path not found: $p"
    fi
  done
  for p in $LINK_THEMES; do
    p="${p/#\~/$HOME}"
    if [[ -d "$p" ]]; then
      ln -s "$p" "$SITE_DIR/wp-content/themes/$(basename "$p")"; ok "Linked theme $(basename "$p")"
    else
      warn "LINK_THEMES path not found: $p"
    fi
  done

  if [[ -n "$theme" ]]; then
    info "Installing theme: $theme"
    theme="${theme/#\~/$HOME}"
    if [[ -d "$theme" ]]; then
      ln -s "$(cd "$theme" && pwd)" "$SITE_DIR/wp-content/themes/$(basename "$theme")"
      wpc theme activate "$(basename "$theme")"
    else
      wpc theme install "$theme" --activate
    fi
  fi

  if [[ "$REMOVE_DEFAULTS" == 1 ]]; then
    wpc plugin delete hello akismet 2>/dev/null || true
    # remove inactive bundled "Twenty*" themes (keeps the active one)
    local t
    for t in $(wp --path="$SITE_DIR" theme list --status=inactive --field=name 2>/dev/null | grep '^twenty' || true); do
      wpc theme delete "$t" || true
    done
    wpc post delete 1 --force 2>/dev/null || true          # "Hello world!"
    wpc post delete 2 --force 2>/dev/null || true          # "Sample Page"
  fi

  if [[ -n "$demo" ]]; then
    # from here a failed demo import shouldn't throw the whole site away
    CREATE_DONE=1
    import_demo "$demo" "$images" || warn "Demo import had errors — the site is still usable. Retry: wpsite demo $name ${demo// /,}"
  fi

  CREATE_DONE=1

  if has valet; then
    if [[ -n "$php" ]]; then
      info "Isolating PHP $php…"
      (cd "$SITE_DIR" && valet isolate "php@$php") || warn "valet isolate failed — is php@$php installed?"
    fi
    if [[ "$secure" == 1 ]]; then
      info "Securing with HTTPS…"
      (cd "$SITE_DIR" && valet secure "$name") || warn "valet secure failed"
    fi
  else
    warn "Valet not found — files and DB are ready, but serve the folder yourself."
  fi

  echo
  ok "${c_b}$name ready in $((SECONDS - start))s${c_0}"
  echo "   URL:    $url"
  echo "   Admin:  $url/wp-admin   ($ADMIN_USER / $ADMIN_PASS)"
  echo "   Path:   $SITE_DIR"
  echo "   DB:     $db"
  echo

  open_url "$url/wp-admin/"
}

# ------------------------------------------------------------------ delete ---
cmd_delete() {
  local name="" yes=0
  for arg in "$@"; do
    case "$arg" in
      -y|--yes) yes=1 ;;
      -*)       die "Unknown option: $arg" ;;
      *)        name="$arg" ;;
    esac
  done

  if [[ -z "$name" ]]; then cmd_list; echo; read -r -p "Site to delete: " name; fi
  validate_name "$name"
  detect_tld

  SITE_DIR="$SITES_DIR/$name"
  [[ -d "$SITE_DIR" ]] || die "No site folder at $SITE_DIR"
  [[ -f "$SITE_DIR/$MARKER" ]] || die "$SITE_DIR wasn't created by wpsite (no $MARKER file). Refusing to delete."

  local db; db="$(db_name_for "$name")"
  if [[ "$yes" != 1 ]]; then
    echo "${c_red}This will permanently delete:${c_0}"
    echo "   Folder:   $SITE_DIR"
    echo "   Database: $db"
    confirm "Delete $name?" || { echo "Cancelled."; exit 0; }
  fi

  if has valet; then
    if is_secured "$name"; then
      info "Removing HTTPS certificate…"; valet unsecure "$name" >/dev/null 2>&1 || warn "valet unsecure failed"
    fi
    (cd "$SITE_DIR" && valet unisolate >/dev/null 2>&1) || true
    valet unlink "$name" >/dev/null 2>&1 || true
  fi

  info "Dropping database $db…"
  if has wp && [[ -f "$SITE_DIR/wp-config.php" ]]; then
    wp --path="$SITE_DIR" db drop --yes --quiet 2>/dev/null || warn "Could not drop $db (already gone?)"
  elif has mysql; then
    MYSQL_PWD="$DB_PASS" mysql -u"$DB_USER" -h"$DB_HOST" -e "DROP DATABASE IF EXISTS \`$db\`;" || warn "Could not drop $db"
  fi

  info "Removing files…"
  # symlinked plugins/themes are removed as links only — the source folders are untouched
  rm -rf -- "$SITE_DIR"
  ok "$name deleted."
}

# -------------------------------------------------------------------- list ---
cmd_list() {
  detect_tld
  local found=0 d n
  echo "${c_b}Sites in $SITES_DIR${c_0}"
  for d in "$SITES_DIR"/*/; do
    [[ -f "$d$MARKER" ]] || continue
    n="$(basename "$d")"; found=1
    local scheme="http"; is_secured "$n" && scheme="https"
    printf "  %-28s %s\n" "$n" "${c_dim}$scheme://$n.$TLD${c_0}"
  done
  [[ $found == 1 ]] || echo "  ${c_dim}(none)${c_0}"
}

cmd_open() {
  local name="${1:-}"; validate_name "$name"; detect_tld
  local scheme="http"; is_secured "$name" && scheme="https"
  OPEN_BROWSER=1; open_url "$scheme://$name.$TLD/wp-admin/"
}

# ------------------------------------------------------------------ config ---
cmd_config() {
  mkdir -p "$CONFIG_DIR"
  if [[ ! -f "$CONFIG_FILE" ]]; then
    cat > "$CONFIG_FILE" <<'EOF'
# wpsite config — plain bash, sourced on every run.

SITES_DIR="$HOME/Sites"        # folder you ran `valet park` in
TLD=""                         # leave empty to auto-detect from `valet tld`

DB_USER="root"
DB_PASS=""
DB_HOST="127.0.0.1"
DB_PREFIX="wp_"

ADMIN_USER="admin"
ADMIN_PASS="password"
ADMIN_EMAIL="admin@example.test"

SECURE=0                       # 1 = https by default
OPEN_BROWSER=1
REMOVE_DEFAULTS=1
WP_DEBUG=1

# wp.org plugin slugs installed on every site
DEFAULT_PLUGINS="query-monitor"

# extra plugins only for `--woo` sites
WOO_PLUGINS=""

# demo data imported into every new site: "", "unittest", "woo" or "all"
DEFAULT_DEMO=""
DEMO_IMAGES=1                  # 0 = skip demo images (faster, works offline)

# your local plugin/theme source folders, symlinked (not copied) into every site
# e.g. LINK_PLUGINS="$HOME/Code/my-plugin $HOME/Code/another-plugin"
LINK_PLUGINS=""
LINK_THEMES=""
EOF
    ok "Created $CONFIG_FILE"
  fi
  "${EDITOR:-nano}" "$CONFIG_FILE"
}

cmd_help() {
  cat <<EOF
${c_b}wpsite $VERSION${c_0} — local WordPress sites with Valet + WP-CLI

  wpsite create <name> [options]   Create a new site
      --woo                          Install WooCommerce (onboarding skipped)
      --theme=<slug|zip|dir>         Install & activate a theme (a dir is symlinked)
      --plugins="a b c"              Extra wp.org plugins to install
      --php=8.3                      Isolate this site to a PHP version
      --wp=6.6                       Specific WordPress version
      --secure / --no-secure         HTTPS on/off (overrides config)
      --no-open                      Don't open the browser
      --demo=unittest|woo|all        Import demo data (woo implies --woo)
      --no-images                    Skip demo images (much faster)

  wpsite demo <name> <type> [--no-images]
                                   Import demo data into an existing site
                                     unittest  WP Theme Unit Test (posts, pages, menus, edge cases)
                                     woo       WooCommerce sample products (simple, variable, grouped, external)
                                     all       both
  wpsite delete <name> [-y]        Delete site folder, database and SSL cert
  wpsite list                      List sites created by wpsite
  wpsite open <name>               Open a site's wp-admin
  wpsite config                    Create/edit $CONFIG_FILE

Examples:
  wpsite create shop --woo --php=8.2 --secure
  wpsite create swatches --demo=woo --plugins="wcboost-variation-swatches"
  wpsite create theme-dev --demo=all --no-images
  wpsite demo shop unittest
  wpsite delete shop -y
EOF
}

# -------------------------------------------------------------------- main ---
cmd="${1:-help}"; shift || true
case "$cmd" in
  create|new|c)    cmd_create "$@" ;;
  delete|rm|d)     cmd_delete "$@" ;;
  list|ls|l)       cmd_list ;;
  open|o)          cmd_open "$@" ;;
  demo)            cmd_demo "$@" ;;
  config)          cmd_config ;;
  help|-h|--help)  cmd_help ;;
  -v|--version)    echo "$VERSION" ;;
  *)               die "Unknown command '$cmd'. Run 'wpsite help'." ;;
esac
